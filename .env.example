# Server-side only. Never commit .env.
PORT=3001
GEMINI_API_KEY=
# Model is configuration only. Must support tool calling.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: tried when the primary model keeps failing with transient errors (429/5xx/network).
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemini-3.1-flash-lite
# Per-turn limits: whole-request deadline, model calls (steps) and tool calls.
REQUEST_TIMEOUT_MS=90000
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
# Requests per minute per model, including retries. Keep at or below your key's limit; quotas vary by account and model.
MODEL_RPM=12
# Model retries (transient errors only) with exponential backoff.
MODEL_MAX_RETRIES=2
MODEL_RETRY_INITIAL_MS=1000
MODEL_RETRY_MAX_MS=8000
# Conversation memory (in-process, no database).
HISTORY_MAX_TURNS=8
HISTORY_MAX_CHARS=24000
SESSION_TTL_MS=3600000
MAX_SESSIONS=200
MAX_CONCURRENT_TURNS=4
# Rewrite answers whose figures are not in the tool results (one extra model call at most).
GROUNDING_CORRECTION=true
# Query the live BTS API for traffic. false = committed snapshot only (offline).
USE_LIVE_TRAFFIC=true
